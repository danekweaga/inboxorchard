# DMFlow Community Edition secrets.
#
# Local development: copy to .dev.vars (gitignored).
# Production: set each value with `npx wrangler secret put NAME`.
# Never commit real credentials.

# Meta Instagram Login credentials from the Instagram API setup screen.
META_APP_ID=your-instagram-app-id
META_APP_SECRET=your-instagram-app-secret
META_VERIFY_TOKEN=generate-a-random-webhook-verify-token

# Single-owner dashboard authentication and encryption.
# Generate independent random values of at least 32 bytes for each.
OWNER_TOKEN=generate-a-long-random-owner-password
SESSION_SECRET=generate-a-separate-session-signing-secret
ENCRYPTION_KEY=generate-a-separate-secret-encryption-key

# Optional Gmail OAuth integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Optional Brevo integration. Stored through the dashboard when practical.
BREVO_API_KEY=

# Optional Google Sheets OAuth shares the Google client credentials above.

# Backwards-compatible aliases read by upgrades from chatmany 0.1.
# APP_ID=
# APP_SECRET=
# WEBHOOK_VERIFY_TOKEN=
