# chatmany secrets — copy the values into Cloudflare with `wrangler secret put <NAME>`.
# NEVER commit real values. This file documents which secrets exist; it holds no real data.
#
#   wrangler secret put APP_ID
#   wrangler secret put APP_SECRET
#   wrangler secret put OWNER_TOKEN
#
# For local dev, put these same keys in a .dev.vars file (gitignored) instead.

# Meta app credentials (Meta app dashboard → App settings → Basic).
# These identify the APP, not your Instagram account.
APP_ID=your-meta-app-id
APP_SECRET=your-meta-app-secret

# A long random string you invent. Guards the config/import, disconnect, and admin routes
# (send it as `Authorization: Bearer <OWNER_TOKEN>` or `?token=<OWNER_TOKEN>`).
OWNER_TOKEN=generate-a-long-random-string

# Optional: webhook verify token, only used when MODE=webhook (Section 5B). You invent this
# and paste the same value into the Meta webhook subscription form.
WEBHOOK_VERIFY_TOKEN=another-random-string
